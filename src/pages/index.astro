---
import Layout from '../layouts/Layout.astro';
import { quotes } from '../data/quotes';
---

<Layout path="/" wide>
    <header>
        <img src="/images/profile.jpg" alt="Sujay Khandekar" class="profile">
        <h1>Sujay Khandekar</h1>
        <p>Engineer in San Francisco</p>
    </header>

    <section>
        <h2>About</h2>
        <p>I write code and talk to the people who use it. I co-run <a href="https://firstcommits.com/">First Commits</a>, a community for founding engineers to swap stories and help each other out. I've also run 5 marathons and a 50-mile ultra.</p>
    </section>

    <section>
        <h2><a href="https://www.withorb.com/">Orb</a></h2>
        <p>First hire, founding engineer. Built billing infrastructure, then found my way to the customer side — support, success, implementations, all of it.</p>
        <p>Currently Head of <a href="https://www.withorb.com/blog/what-it-means-to-be-a-forward-deployed-engineer-at-orb">Forward Deployed Engineering</a>, working with companies like Vercel, Perplexity, and Redis to get their billing running.</p>
    </section>

    <section>
        <h2><a href="https://www.samsara.com/">Samsara</a></h2>
        <p>Previously, full-stack engineer on trucking and fleet products. Hours of Service compliance, satellite infrastructure for e-logbooks. Not glamorous, but it keeps trucks on the road.</p>
    </section>

    <section>
        <h2><a href="https://cs.illinois.edu/">University of Illinois</a></h2>
        <p>BS and MS in computer science. For my master's, I researched how people actually use emojis and built an app called <a href="http://ranjithakumar.net/resources/opico.pdf">Opico</a> to study it.</p>
        <ul>
            <li><a href="https://cs.illinois.edu/news/two-cs-students-selected-knights-st-patrick">Knight of St. Patrick</a> — highest honor from the College of Engineering</li>
            <li><a href="https://siebelschool.illinois.edu/news/top-cs-illinois-students-named-2018-siebel-scholars">Siebel Scholar</a> — ~80 selected globally each year</li>
            <li>Co-invented the <a href="https://www.chicagotribune.com/lifestyles/ct-life-illinois-researcher-bubble-tea-emoji-tt-20190717-akfso6mwk5d2jffryieyuytdsq-story.html">boba emoji</a> 🧋</li>
        </ul>
    </section>

    <section class="quotes-gallery" aria-label="Favorite quotes">
        <ul class="quote-grid">
            {quotes.map((quote, index) => (
                <li class="quote" style={`--i: ${index}`}>
                    <figure>
                        {quote.image ? (
                            <img
                                src={quote.image}
                                alt={`“${quote.text}” — ${quote.source}`}
                                loading="lazy"
                                decoding="async"
                            />
                        ) : (
                            <blockquote>
                                <p>{quote.text}</p>
                            </blockquote>
                        )}
                        <figcaption>{quote.source}</figcaption>
                    </figure>
                </li>
            ))}
        </ul>
    </section>

    <footer>
        <nav>
            <a href="https://x.com/sujaykhandekar">X</a>
            <a href="https://www.linkedin.com/in/sujaykhandekar/">LinkedIn</a>
        </nav>
    </footer>
</Layout>
